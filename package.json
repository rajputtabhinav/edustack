{
  "name": "edustack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend",
    "bot"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:bot\"",
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:bot": "npm --workspace bot run dev",
    "build": "npm run build --workspace backend && npm run build --workspace frontend && npm run build --workspace bot"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.7.1",
    "node-telegram-bot-api": "^0.66.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
